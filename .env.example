# prod 프로필이 환경변수로 받는 값의 이름만 적는다. 실제 값은 저장소에 두지 않는다.
# local·e2e는 환경변수 없이 compose.yaml의 개발 전용 값을 쓴다.
# 백엔드 이미지(backend/Dockerfile)는 prod 프로필로 고정돼 있어 아래 네 값이 없으면 시작하지 않는다.

# PostgreSQL 접속 정보 (예: jdbc:postgresql://<호스트>:5432/<DB 이름>)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# JWT 서명 키(HS256). 32바이트 이상. 없거나 짧으면 애플리케이션이 시작되지 않는다.
JWT_SECRET=

# (선택) 백엔드 JVM 옵션. 비워 두면 이미지 기본값(-Xmx512m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError, 결정 0214)을 쓴다.
# 값을 주면 기본값을 통째로 바꾼다.
# JDK_JAVA_OPTIONS=
